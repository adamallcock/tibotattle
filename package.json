{
  "name": "app-usagemonitor",
  "version": "0.1.16",
  "private": true,
  "type": "module",
  "description": "Local-only quota and standard API-price usage triangulation experiment.",
  "license": "MIT",
  "bin": {
    "usage-monitor": "./src/cli.js"
  },
  "scripts": {
    "architecture:check": "node ./scripts/check-architecture-boundaries.mjs",
    "benchmark:r7:release:regenerate": "node ./scripts/regenerate-r7-release-evidence.js",
    "benchmark:r7:smoke": "node ./src/cli.js benchmark-r7 --profile smoke --output .usage-monitor/r7-resource-benchmark-smoke-v0.1.json",
    "build:prospective-transitions": "node ./tools/reports/build-prospective-collector-transitions.js",
    "build:quality-report-data": "node ./src/build-monitoring-quality-report.js",
    "build:report-data": "node ./src/build-multi-surface-report.js",
    "build:rolling-history": "node ./src/build-rolling-quota-history.js",
    "build:simple-report-data": "node ./src/build-simple-quota-gradient-report.js",
    "build:weekly-calibration-audit": "node ./src/build-weekly-calibration-audit.js",
    "build:weekly-calibration-report-data": "node ./src/build-weekly-calibration-report.js",
    "calibrate:weekly": "node ./src/cli.js calibrate-weekly --input .usage-monitor/transitions-simple-history-2026-06-11-to-2026-07-24-v0.3.2.json --output .usage-monitor/weekly-calibration-v0.2.json --report-file .usage-monitor/2026-07-24-weekly-calibration-v0.2.md",
    "capture": "node ./src/cli.js capture",
    "check": "npm test && npm run product:check",
    "collect-foreground": "node ./src/cli.js collect-foreground",
    "collect-once": "node ./src/cli.js collect-once",
    "container:portable:build": "docker build --file containers/portable/Dockerfile --tag tibotattle-portable:test .",
    "container:portable:test": "docker run --rm --init --network none --env USAGE_MONITOR_TEST_LANE_REPORTER=dot tibotattle-portable:test",
    "contamination": "node ./src/cli.js contamination",
    "crosscheck": "node ./src/cli.js crosscheck",
    "diagnose:dashboard": "node ./scripts/inspect-dashboard-state.mjs",
    "docs:links:check": "node ./tools/operations/fix-doc-links.mjs --check",
    "docs:links:fix": "node ./tools/operations/fix-doc-links.mjs",
    "doctor": "node ./src/cli.js doctor",
    "evaluate:minimization": "node ./scripts/minimization-ablation.js --input .usage-monitor/transitions-v0.3.2.json --output .usage-monitor/minimization-ablation-v0.1.json --prospective-after 2026-07-24T00:00:00.000Z --fixture test/fixtures/minimization-codex-shaped-v1.json --fixture test/fixtures/minimization-claude-shaped-v1.json",
    "experiment": "node ./src/cli.js experiment",
    "export:local": "node ./src/cli.js export-local",
    "fix:report-width": "node ./src/fix-portable-report-width.js",
    "history": "node ./src/cli.js history",
    "i18n:browser:check": "node ./scripts/generate-i18n-browser-mirror.js --check",
    "i18n:browser:generate": "node ./scripts/generate-i18n-browser-mirror.js",
    "index:rebuild": "node ./scripts/rebuild-local-unified-index.mjs",
    "infer": "node ./src/cli.js infer",
    "inspect:export": "node ./src/cli.js inspect-export",
    "mark:activity": "node ./src/cli.js mark-activity",
    "migrate-corrections": "node ./src/cli.js migrate-corrections",
    "migrate:legacy-reports": "node ./scripts/migrate-local-legacy-reports.mjs",
    "product:backend:acceptance": "npm --prefix apps/worker run acceptance:local --",
    "product:backend:acceptance:real-local": "node ./scripts/run-real-local-backend-acceptance.js",
    "product:backend:account-scoped-smoke": "npm --prefix apps/worker run smoke:account-scoped:http --",
    "product:backend:incident-smoke": "npm --prefix apps/worker run smoke:incident:http --",
    "product:backend:inspect": "npm --prefix apps/worker run inspect:local-state --",
    "product:backend:lab": "npm --prefix apps/worker run lab:local --",
    "product:backend:load": "npm --prefix apps/worker run load:http --",
    "product:backend:load-profile": "npm --prefix apps/worker run load:profile",
    "product:backend:only": "npm --prefix apps/worker run lab:local -- --backend-only",
    "product:backend:queue-smoke": "npm --prefix apps/worker run smoke:queue:http --",
    "product:backend:smoke": "npm --prefix apps/worker run smoke:http --",
    "product:backend:test": "npm --prefix apps/worker test",
    "product:check": "npm run architecture:check && npm run tools:inventory:check && npm run telemetry:browser:check && npm run telemetry:upload-schemas:check && npm run product:ui:test && npm run product:release-site:test && npm run product:local:test && npm run product:worker:check && npm run product:cloud-run:check && npm run product:macos:test && npm run product:local-review:runtime",
    "product:cloud-run:check": "npm --prefix apps/cloud-run run check",
    "product:dev": "npm --prefix apps/worker run dev",
    "product:dev:account-scoped": "npm --prefix apps/worker run dev:account-scoped",
    "product:keys:local": "npm --prefix apps/worker run keys:local",
    "product:keys:staging": "npm --prefix apps/worker run keys:staging",
    "product:local": "node ./apps/local/server.js",
    "product:local-review:runtime": "node ./scripts/verify-local-review-runtime.js --output \".release-build/local-review-runtime\"",
    "product:local:test": "node --test --test-concurrency=1 test/local-companion-data.test.js test/local-companion-refresh.test.js test/local-contribution-preparation.test.js test/real-local-backend-acceptance.test.js test/telemetry-contribution-builder.test.js test/contribution-device-sync.test.js test/contribution-sync-queue.test.js test/contribution-device-cli.test.js apps/local/*.test.mjs",
    "product:macos:appcast": "node ./scripts/generate-sparkle-appcast.js",
    "product:macos:build": "node ./scripts/build-macos-app.js --output \".release-build/macos/TiboTattle.app\"",
    "product:macos:dmg": "node ./scripts/package-macos-dmg.js --app \".release-build/macos/TiboTattle.app\" --development --replace",
    "product:macos:preview": "npm run product:macos:preview:build && npm run product:macos:preview:validate",
    "product:macos:preview:build": "npm run product:macos:updater:prepare && node ./scripts/build-macos-app.js --preview-distribution --replace-preview-output",
    "product:macos:preview:install": "node ./scripts/install-macos-preview-app.js --app \".release-build/macos-preview/current/TiboTattle.app\" --target \"/Applications/TiboTattle.app\" --replace --confirm-system-install",
    "product:macos:preview:reinstall": "npm run product:macos:preview && npm run product:macos:preview:install",
    "product:macos:preview:remote": "node ./scripts/verify-macos-preview-remote.js --app \".release-build/macos-preview/current/TiboTattle.app\" --channel preview_distribution",
    "product:macos:preview:remote:live": "npm run product:macos:preview:remote -- --live",
    "product:macos:preview:validate": "node ./scripts/build-macos-app.js --validate-preview --app \".release-build/macos-preview/current/TiboTattle.app\"",
    "product:macos:publish-update": "node ./scripts/publish-sparkle-update.js",
    "product:macos:release": "node ./scripts/release-macos-app.js --app \".release-build/macos-production/TiboTattle.app\"",
    "product:macos:test": "npm run product:macos:updater:prepare && USAGE_MONITOR_TEST_LANES=0 USAGE_MONITOR_MACOS_TEST_SCOPE=all node --test --test-concurrency=1 test/macos-app-bundle.test.js test/macos-updater.test.js test/macos-updater-release.test.mjs",
    "product:macos:updater:prepare": "node ./scripts/prepare-sparkle-framework.js --output \".release-deps/Sparkle.framework\"",
    "product:macos:validate:development": "node ./scripts/validate-macos-install.js --app \".release-build/macos/TiboTattle.app\" --channel stable --development",
    "product:macos:validate:login-item-release": "node ./scripts/validate-macos-login-item-release.js",
    "product:macos:validate:release": "node ./scripts/validate-macos-install.js --release --channel stable",
    "product:native-network-audit:build": "node ./scripts/build-native-network-audit.js --output \".release-build/native-network-audit/libusage_monitor_network_audit.dylib\"",
    "product:prepare-contribution": "node ./scripts/build-telemetry-contributions.js",
    "product:release-site": "node ./scripts/build-public-release-site.js",
    "product:release-site:preview": "node ./scripts/preview-public-release-site.js",
    "product:release-site:test": "node --test test/public-release-site.test.js test/public-release-site-preview.test.js test/web-release-lane.test.js",
    "product:social-preview": "node ./scripts/generate-social-preview.js",
    "product:staging:check": "npm --prefix apps/worker run staging:check",
    "product:staging:deploy": "npm --prefix apps/worker run staging:deploy --",
    "product:staging:prepare": "npm --prefix apps/worker run staging:prepare --",
    "product:staging:ready": "npm --prefix apps/worker run staging:ready",
    "product:ui:test": "node --test apps/web/test/*.test.mjs",
    "product:web-release:deploy": "node ./scripts/deploy-web-release.js",
    "product:web-release:prepare": "node ./scripts/prepare-web-release.js",
    "product:web-release:test": "node --test test/web-release-lane.test.js",
    "product:worker:check": "npm --prefix apps/worker run check",
    "quality": "node ./src/cli.js quality",
    "register-account": "node ./src/cli.js register-account",
    "release:evidence:generate": "node ./scripts/generate-release-evidence.js",
    "release:evidence:validate": "node ./scripts/generate-release-evidence.js --validate",
    "release:trust:check": "node --test test/release-workflow-policy.test.js test/release-evidence.test.js test/release-attestation-action.test.js test/release-sbom-action.test.js",
    "report": "node ./src/cli.js report",
    "rotate:identity": "node ./src/cli.js rotate-local-identity",
    "telemetry:browser:check": "node ./scripts/generate-telemetry-browser-mirror.js --check",
    "telemetry:browser:generate": "node ./scripts/generate-telemetry-browser-mirror.js",
    "telemetry:check": "node ./scripts/generate-telemetry-contract.js --check && node --test test/telemetry-contract.test.js test/export-schema.test.js",
    "telemetry:generate": "node ./scripts/generate-telemetry-contract.js",
    "telemetry:upload-schemas:check": "node ./packages/telemetry-contract/scripts/sync-json-schemas.mjs --check",
    "telemetry:upload-schemas:generate": "node ./packages/telemetry-contract/scripts/sync-json-schemas.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.js apps/web/test/*.test.mjs",
    "test:benchmark": "node ./scripts/benchmark-test-lanes.mjs",
    "test:benchmark:release": "node ./scripts/benchmark-test-lanes.mjs --release-gate",
    "test:changed": "node ./scripts/test-lanes.mjs changed",
    "test:changed:full": "node ./scripts/test-lanes.mjs changed --full",
    "test:fast": "node ./scripts/test-lanes.mjs fast",
    "test:macos:artifact": "node ./scripts/test-lanes.mjs macos-artifact",
    "test:macos:smoke": "node ./scripts/test-lanes.mjs macos-smoke",
    "test:macos:source": "node ./scripts/test-lanes.mjs macos-source",
    "test:portable": "node ./scripts/test-lanes.mjs portable",
    "test:preflight": "npm run tools:root-workspace:check && node ./scripts/test-lanes.mjs preflight",
    "tools": "node ./src/cli.js tools",
    "tools:inventory:check": "node ./tools/operations/check-tool-inventory.mjs",
    "tools:root-workspace:check": "node ./scripts/check-root-workspace-hygiene.mjs",
    "transitions": "node ./src/cli.js transitions",
    "verify:weekly-calibration": "node ./src/verify-weekly-calibration.js"
  },
  "dependencies": {
    "@app-usagemonitor/accounting": "workspace:*",
    "@app-usagemonitor/i18n": "workspace:*",
    "@app-usagemonitor/identity-core": "workspace:*",
    "@app-usagemonitor/quota-analysis": "workspace:*",
    "@app-usagemonitor/telemetry-contract": "workspace:*",
    "@github/keytar": "7.10.6",
    "ajv": "^8.20.0",
    "ccusage": "20.0.18",
    "runcost": "0.2.1"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.9.0",
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.15.7",
    "es-module-lexer": "2.3.1",
    "fast-check": "^4.9.0"
  }
}
