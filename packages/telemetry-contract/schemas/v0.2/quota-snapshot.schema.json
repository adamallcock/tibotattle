{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://app-usagemonitor.local/schemas/telemetry-contribution-v0.2/quota-snapshot.schema.json",
  "title": "Disabled plaintext telemetry quota snapshot v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "observedTime",
    "receivedTime",
    "provider",
    "planType",
    "planVariant",
    "limitId",
    "slot",
    "usedPercent",
    "displayPrecision",
    "windowDurationMinutes",
    "resetsAt",
    "snapshotSource",
    "providerSurface",
    "snapshotId",
    "accountTrackId"
  ],
  "properties": {
    "schemaVersion": { "const": "quota-snapshot-v0.2" },
    "observedTime": { "type": "string", "format": "date-time", "maxLength": 32 },
    "receivedTime": { "type": "string", "format": "date-time", "maxLength": 32 },
    "provider": { "enum": ["openai_codex", "anthropic_claude_code"] },
    "planType": {
      "enum": ["free", "go", "plus", "pro", "prolite", "business", "enterprise", "edu", "team", "self_serve_business_prolite", "self_serve_business_usage_based", "ent26", "enterprise_cbp_automation", "enterprise_cbp_usage_based", "unknown"]
    },
    "planVariant": {
      "enum": ["pro-20x", "pro-10x-promo", "pro-5x", "plus", "unknown"]
    },
    "limitId": { "enum": ["unknown", "codex", "codex-spark"] },
    "slot": {
      "enum": ["primary", "secondary", "five_hour", "seven_day", "other", "unknown"]
    },
    "usedPercent": { "type": "number", "minimum": 0, "maximum": 100 },
    "displayPrecision": { "type": "integer", "minimum": 0, "maximum": 6 },
    "windowDurationMinutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 525600
    },
    "resetsAt": { "type": "string", "format": "date-time", "maxLength": 32 },
    "snapshotSource": {
      "enum": ["rollout", "app_server_read", "status_line", "ui_declaration", "notification"]
    },
    "providerSurface": {
      "enum": [
        "account_shared_unallocated",
        "general_usage",
        "model_specific",
        "separate_limit",
        "unknown"
      ]
    },
    "snapshotId": {
      "type": "string",
      "pattern": "^snapshot:v2:(?:[a-f0-9]{64}|[A-Za-z0-9_-]{43})$"
    },
    "accountTrackId": {
      "type": "string",
      "pattern": "^(unattributed|account-track:v1:[a-f0-9]{64})$"
    }
  }
}
