{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://app-usagemonitor.local/schemas/telemetry-contribution-v0.2/contribution.schema.json",
  "title": "Frozen disabled plaintext telemetry contribution v0.2",
  "description": "Local construction and review contract only. Transport remains disabled.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "consentVersion",
    "status",
    "synthetic",
    "datasetId",
    "partIndex",
    "partCount",
    "completeness",
    "createdAt",
    "coveredAt",
    "clientPlatform",
    "providerPolicyEpoch",
    "usageEvents",
    "quotaSnapshots",
    "activityMarkers",
    "accountingDiagnostic"
  ],
  "properties": {
    "schemaVersion": { "const": "telemetry-contribution-v0.2" },
    "consentVersion": { "const": "privacy-safe-telemetry-v0.2" },
    "status": { "const": "implementation_disabled" },
    "synthetic": { "const": false },
    "datasetId": {
      "type": "string",
      "pattern": "^dataset:v1:[a-f0-9]{64}$",
      "description": "Participant-scoped dataset namespace; not an authentication credential."
    },
    "partIndex": { "type": "integer", "minimum": 1, "maximum": 100 },
    "partCount": { "type": "integer", "minimum": 1, "maximum": 100 },
    "completeness": { "enum": ["complete", "partial"] },
    "createdAt": { "type": "string", "format": "date-time", "maxLength": 32 },
    "coveredAt": {
      "type": "object",
      "readOnly": true,
      "additionalProperties": false,
      "required": ["startAt", "endAt"],
      "properties": {
        "startAt": { "type": "string", "format": "date-time", "maxLength": 32 },
        "endAt": { "type": "string", "format": "date-time", "maxLength": 32 }
      }
    },
    "clientPlatform": { "enum": ["macos", "linux", "windows", "other", "unknown"] },
    "providerPolicyEpoch": {
      "enum": [
        "openai_pre_agentic_pool_2026_07_09",
        "openai_agentic_pool_2026_07_09",
        "anthropic_unknown",
        "unknown"
      ]
    },
    "usageEvents": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "https://app-usagemonitor.local/schemas/telemetry-contribution-v0.2/usage-event.schema.json"
      }
    },
    "quotaSnapshots": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "https://app-usagemonitor.local/schemas/telemetry-contribution-v0.2/quota-snapshot.schema.json"
      }
    },
    "activityMarkers": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "https://app-usagemonitor.local/schemas/telemetry-contribution-v0.2/activity-marker.schema.json"
      }
    },
    "accountingDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "sourceSchemaVersion",
        "estimatedApiCostUsd",
        "pricedEventCoveragePercent",
        "unknownModelEventCount",
        "unknownBillableUnits",
        "priceBasis"
      ],
      "properties": {
        "status": { "const": "untrusted_diagnostic" },
        "sourceSchemaVersion": { "const": "telemetry-contribution-v0.1" },
        "estimatedApiCostUsd": {
          "type": ["string", "null"],
          "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{6}$"
        },
        "pricedEventCoveragePercent": { "type": "number", "minimum": 0, "maximum": 100 },
        "unknownModelEventCount": { "type": "integer", "minimum": 0 },
        "unknownBillableUnits": { "type": "integer", "minimum": 0 },
        "priceBasis": { "enum": ["current_api_prices", "historical_api_prices", "unpriced", "mixed_api_prices"] }
      }
    }
  }
}
