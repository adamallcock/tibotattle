{
  "compilerOptions": {
    "target": "ES2024",
    "lib": [
      "ES2024",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": []
  },
  "files": [
    "src/release-guard-application.ts",
    "src/gcs-release-object-store.ts",
    "src/quarantine-object-store.ts",
    "src/telemetry-v1-contribution-store.ts"
  ]
}
