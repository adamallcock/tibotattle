// Staging edge template (STG-DRV). Placeholders only: no account id, database
// id, Access AUD or email is committed. scripts/staging-edge-target.mjs fills
// it from the owner's private, non-secret inputs file (schema
// staging-edge-inputs-v1; see staging-edge-inputs.example.json) and refuses any
// production Worker name, hostname, D1, bucket or rate-limit namespace.
//
// edgeWorker is the staging Worker as its config's env.production, the shape
// the typed render rebuilds (production-live-config.mjs) and EP-9's staging
// overlay accepts. It is never deployed as written: the driver renders it,
// overlays the mode (main = src/edge-entry.ts, EDGE_UPSTREAM_MODE) and deploys
// that candidate with --env production. Its vars start from the checked-in
// env.staging and change only what the staging-edge plan's section 3.2 lists.
// TELEMETRY_STORAGE_NAMESPACE is omitted: JSON storage mode never reads it, and
// the typed render refuses an empty var. The data D1s carry no migrations_dir,
// because a typed config may name one only for RELEASE_GUARD_DB; their
// migrations go through the rendered per-database migration configs.
//
// rateLimitProfiles holds the two named profiles of plan section 3.1. A typed
// redeploy reproduces the live limits, so the profile takes effect at the
// genesis deploy only.
{
  "schema": "staging-edge-template-v1",
  "edgeWorker": {
    "name": "{{EDGE_WORKER_NAME}}",
    "main": "src/edge-entry.ts",
    "account_id": "{{ACCOUNT_ID}}",
    "compatibility_date": "2026-07-26",
    "compatibility_flags": ["nodejs_compat"],
    "env": {
      "production": {
        "name": "{{EDGE_WORKER_NAME}}",
        "main": "src/edge-entry.ts",
        "compatibility_date": "2026-07-26",
        "compatibility_flags": ["nodejs_compat"],
        "workers_dev": false,
        "preview_urls": false,
        "routes": [
          { "pattern": "{{PUBLIC_HOSTNAME}}", "custom_domain": true },
          { "pattern": "{{ADMIN_HOSTNAME}}", "custom_domain": true }
        ],
        "limits": { "cpu_ms": 300000 },
        "cache": { "enabled": true, "cross_version_cache": false },
        "observability": { "enabled": true, "head_sampling_rate": 1 },
        "logpush": false,
        "tail_consumers": [],
        "triggers": { "crons": ["* * * * *"] },
        "vars": {
          "PUBLIC_ANALYTICS_MODE": "enabled",
          "ENVIRONMENT": "staging",
          "ENROLLMENT_MODE": "disabled",
          "ACCOUNTLESS_ENROLLMENT_MODE": "disabled",
          "ACCOUNTLESS_OWNERSHIP_MODE": "disabled",
          "ACCOUNT_SCOPED_INGEST_MODE": "disabled",
          "TELEMETRY_STORAGE_MODE": "json",
          "UPLOAD_INGRESS_QUEUE_MODE": "disabled",
          "UPLOAD_INGRESS_MAX_CONCURRENT": "8",
          "UPLOAD_INGRESS_MAX_STARTS_PER_MINUTE": "120",
          "UPLOAD_INGRESS_BURST": "16",
          "UPLOAD_INGRESS_LEASE_SECONDS": "90",
          "UPLOAD_INGRESS_BODY_TOTAL_SECONDS": "60",
          "UPLOAD_INGRESS_BODY_IDLE_SECONDS": "15",
          "SIGN_IN_START_MAX_PER_MINUTE": "5",
          "IDENTITY_LINK_SECRET_VERSION": "staging-edge-v1",
          "PUBLIC_ORIGIN": "https://{{PUBLIC_HOSTNAME}}",
          "ACCESS_TEAM_DOMAIN": "{{ACCESS_TEAM_DOMAIN}}",
          "ACCESS_AUD": "{{ACCESS_AUD}}",
          "ACCESS_ADMIN_EMAIL": "{{ACCESS_ADMIN_EMAIL}}",
          "SPARKLE_APPCAST_GUARD_MODE": "disabled"
        },
        "secrets": {
          "required": ["ENVELOPE_PRIVATE_JWK", "ENVELOPE_PUBLIC_JWK", "IDENTITY_LINK_SECRET"]
        },
        "ratelimits": "{{RATE_LIMITS}}",
        "durable_objects": {
          "bindings": [{ "name": "UPLOAD_INGRESS_BUDGET", "class_name": "UploadIngressBudget" }]
        },
        "migrations": [{ "tag": "upload-ingress-budget-v1", "new_sqlite_classes": ["UploadIngressBudget"] }],
        "d1_databases": [
          { "binding": "USAGE_MONITOR_DB", "database_name": "{{D1_INGESTION_NAME}}", "database_id": "{{D1_INGESTION_ID}}" },
          { "binding": "ANALYTICS_DB", "database_name": "{{D1_ANALYTICS_NAME}}", "database_id": "{{D1_ANALYTICS_ID}}" },
          { "binding": "DELETION_LEDGER", "database_name": "{{D1_DELETION_LEDGER_NAME}}", "database_id": "{{D1_DELETION_LEDGER_ID}}" }
        ],
        "r2_buckets": [
          { "binding": "QUARANTINE", "bucket_name": "{{R2_QUARANTINE}}" },
          { "binding": "SPARKLE_RELEASES", "bucket_name": "{{R2_SPARKLE_RELEASES}}" }
        ],
        "assets": {
          "binding": "ASSETS",
          "directory": "../../.release-build/public-release-site",
          "not_found_handling": "404-page",
          "run_worker_first": true
        }
      }
    }
  },
  "standInWorker": {
    "name": "{{STAND_IN_WORKER_NAME}}",
    "main": "ops/staging-edge/catchup-standin/index.mjs",
    "account_id": "{{ACCOUNT_ID}}",
    "compatibility_date": "2026-07-26",
    "workers_dev": false,
    "preview_urls": false,
    "triggers": { "crons": ["{{STAND_IN_CRON}}"] },
    "d1_databases": [
      {
        "binding": "STORAGE_ANALYTICS_CATCHUP_CONTROL_DB",
        "database_name": "{{D1_CATCHUP_CONTROL_NAME}}",
        "database_id": "{{D1_CATCHUP_CONTROL_ID}}",
        "migrations_dir": "ops/staging-edge/catchup-standin/migrations"
      }
    ]
  },
  "rateLimitProfiles": {
    "rehearsal": [
      { "name": "ENROLLMENT_RATE_LIMIT", "namespace_id": "4001", "simple": { "limit": 20, "period": 60 } },
      { "name": "RECOVERY_RATE_LIMIT", "namespace_id": "4002", "simple": { "limit": 20, "period": 60 } },
      { "name": "CLIENT_ATTEMPT_RATE_LIMIT", "namespace_id": "4003", "simple": { "limit": 5, "period": 60 } },
      { "name": "PUBLIC_READ_RATE_LIMIT", "namespace_id": "4004", "simple": { "limit": 120, "period": 60 } },
      { "name": "UPLOAD_AUTHORIZATION_RATE_LIMIT", "namespace_id": "4005", "simple": { "limit": 3000, "period": 60 } },
      { "name": "UPLOAD_PRINCIPAL_RATE_LIMIT", "namespace_id": "4006", "simple": { "limit": 3000, "period": 60 } },
      { "name": "UPLOAD_INGRESS_REQUEST_RATE_LIMIT", "namespace_id": "4007", "simple": { "limit": 3000, "period": 60 } },
      { "name": "UPLOAD_INGRESS_CLIENT_RATE_LIMIT", "namespace_id": "4008", "simple": { "limit": 3000, "period": 60 } },
      { "name": "PUBLIC_PROBE_RATE_LIMIT", "namespace_id": "4009", "simple": { "limit": 60, "period": 60 } },
      { "name": "PUBLIC_PROBE_CLIENT_RATE_LIMIT", "namespace_id": "4010", "simple": { "limit": 12, "period": 60 } },
      { "name": "SPARKLE_APPCAST_GUARD_RATE_LIMIT", "namespace_id": "4012", "simple": { "limit": 60, "period": 60 } }
    ],
    "load": [
      { "name": "ENROLLMENT_RATE_LIMIT", "namespace_id": "4001", "simple": { "limit": 20, "period": 60 } },
      { "name": "RECOVERY_RATE_LIMIT", "namespace_id": "4002", "simple": { "limit": 20, "period": 60 } },
      { "name": "CLIENT_ATTEMPT_RATE_LIMIT", "namespace_id": "4003", "simple": { "limit": 5, "period": 60 } },
      { "name": "PUBLIC_READ_RATE_LIMIT", "namespace_id": "4004", "simple": { "limit": 120, "period": 60 } },
      { "name": "UPLOAD_AUTHORIZATION_RATE_LIMIT", "namespace_id": "4005", "simple": { "limit": 3000, "period": 60 } },
      { "name": "UPLOAD_PRINCIPAL_RATE_LIMIT", "namespace_id": "4006", "simple": { "limit": 3000, "period": 60 } },
      { "name": "UPLOAD_INGRESS_REQUEST_RATE_LIMIT", "namespace_id": "4007", "simple": { "limit": 12000, "period": 60 } },
      { "name": "UPLOAD_INGRESS_CLIENT_RATE_LIMIT", "namespace_id": "4008", "simple": { "limit": 12000, "period": 60 } },
      { "name": "PUBLIC_PROBE_RATE_LIMIT", "namespace_id": "4009", "simple": { "limit": 60, "period": 60 } },
      { "name": "PUBLIC_PROBE_CLIENT_RATE_LIMIT", "namespace_id": "4010", "simple": { "limit": 12, "period": 60 } },
      { "name": "SPARKLE_APPCAST_GUARD_RATE_LIMIT", "namespace_id": "4012", "simple": { "limit": 60, "period": 60 } }
    ]
  }
}
