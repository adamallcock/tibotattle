{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "tibotattle-gcs-test-local",
  "main": "worker.ts",
  "compatibility_date": "2026-07-26",
  "workers_dev": false,
  "preview_urls": false,
  "dev": {
    "ip": "127.0.0.1",
    "port": 8799
  },
  "d1_databases": [
    {
      "binding": "TEST_RELEASE_NONCES",
      "database_name": "tibotattle-gcs-test-local-nonces",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "remote": false
    }
  ],
  "secrets": {
    "required": [
      "GCS_TEST_BUCKET",
      "GCS_TEST_RUN_ID",
      "GCS_ACCESS_TOKEN",
      "GCS_ACCESS_TOKEN_EXPIRES_AT",
      "GCS_TEST_RELEASE_TOKEN",
      "GCS_TEST_PUBLIC_ED_KEY",
      "GCS_TEST_PUBLIC_ED_KEY_SHA256"
    ]
  }
}
