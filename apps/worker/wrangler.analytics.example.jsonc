{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tibotattle-analytics-unbound-example",
  "main": "src/storage-analytics-worker.ts",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": [] },
  "vars": {
    "STORAGE_ANALYTICS_MODE": "disabled",
    "STORAGE_SOURCE_ID": "unbound-example",
    "TELEMETRY_STORAGE_NAMESPACE": "unbound-example"
  },
  "d1_databases": [
    { "binding": "STORAGE_INGESTION_DB", "database_name": "unbound-ingestion-example", "database_id": "11111111-1111-4111-8111-111111111111" },
    { "binding": "STORAGE_ANALYTICS_DB", "database_name": "unbound-analytics-example", "database_id": "22222222-2222-4222-8222-222222222222" },
    { "binding": "DELETION_LEDGER", "database_name": "unbound-deletion-ledger-example", "database_id": "33333333-3333-4333-8333-333333333333" }
  ]
}
