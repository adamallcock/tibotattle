{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "app-usagemonitor-synthetic",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "vars": {
    "ENVIRONMENT": "synthetic-development",
    "ENROLLMENT_MODE": "local_open",
    "ACCOUNT_SCOPED_INGEST_MODE": "disabled"
  },
  "secrets": {
    "required": [
      "ENVELOPE_PRIVATE_JWK",
      "ENVELOPE_PUBLIC_JWK"
    ]
  },
  "ratelimits": [
    {
      "name": "ENROLLMENT_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "RECOVERY_RATE_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "USAGE_MONITOR_DB",
      "database_name": "app-usagemonitor-synthetic",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    },
    {
      "binding": "DELETION_LEDGER",
      "database_name": "app-usagemonitor-synthetic-deletion-ledger",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "deletion-ledger-migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "QUARANTINE",
      "bucket_name": "app-usagemonitor-synthetic-quarantine"
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "../web/public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "env": {
    "staging": {
      "name": "app-usagemonitor-staging",
      "workers_dev": true,
      "preview_urls": false,
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1
      },
      "triggers": {
        "crons": ["0 * * * *"]
      },
      "vars": {
        "ENVIRONMENT": "staging",
        "ENROLLMENT_MODE": "disabled",
        "ACCOUNT_SCOPED_INGEST_MODE": "disabled"
      },
      "secrets": {
        "required": [
          "ENVELOPE_PRIVATE_JWK",
          "ENVELOPE_PUBLIC_JWK"
        ]
      },
      "ratelimits": [
        {
          "name": "ENROLLMENT_RATE_LIMIT",
          "namespace_id": "2001",
          "simple": { "limit": 20, "period": 60 }
        },
        {
          "name": "RECOVERY_RATE_LIMIT",
          "namespace_id": "2002",
          "simple": { "limit": 20, "period": 60 }
        }
      ],
      "d1_databases": [
        {
          "binding": "USAGE_MONITOR_DB",
          "database_name": "app-usagemonitor-staging",
          "database_id": "00000000-0000-4000-8000-000000000010",
          "migrations_dir": "migrations"
        },
        {
          "binding": "DELETION_LEDGER",
          "database_name": "app-usagemonitor-staging-deletion-ledger",
          "database_id": "00000000-0000-4000-8000-000000000011",
          "migrations_dir": "deletion-ledger-migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "QUARANTINE",
          "bucket_name": "app-usagemonitor-staging-quarantine"
        }
      ],
      "assets": {
        "binding": "ASSETS",
        "directory": "../web/public",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"]
      }
    }
  }
}
