// Local synthetic role only. No hosted IDs, routes, credentials or enabled schedule.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tibotattle-synthetic-storage-analytics",
  "main": "src/storage-analytics-worker.ts",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": []
  },
  "vars": {
    "STORAGE_ANALYTICS_MODE": "disabled",
    "STORAGE_ROUTING_MODE": "catalog",
    "STORAGE_SOURCE_NAMESPACE_A": "synthetic-a",
    "STORAGE_SOURCE_NAMESPACE_B": "synthetic-b",
    "STORAGE_SOURCE_NAMESPACE_C": "synthetic-c"
  },
  "d1_databases": [
    {
      "binding": "STORAGE_ROUTING_DB",
      "database_name": "synthetic-storage-routing-db",
      "database_id": "00000000-0000-0000-0000-000000000002"
    },
    {
      "binding": "DELETION_LEDGER",
      "database_name": "synthetic-deletion-ledger",
      "database_id": "00000000-0000-0000-0000-000000000001"
    },
    {
      "binding": "STORAGE_INGESTION_A",
      "database_name": "synthetic-storage-ingestion-a",
      "database_id": "00000000-0000-0000-0000-000000000003"
    },
    {
      "binding": "STORAGE_INGESTION_B",
      "database_name": "synthetic-storage-ingestion-b",
      "database_id": "00000000-0000-0000-0000-000000000004"
    },
    {
      "binding": "STORAGE_INGESTION_C",
      "database_name": "synthetic-storage-ingestion-c",
      "database_id": "00000000-0000-0000-0000-000000000005"
    },
    {
      "binding": "STORAGE_ANALYTICS_A",
      "database_name": "synthetic-storage-analytics-a",
      "database_id": "00000000-0000-0000-0000-000000000006"
    },
    {
      "binding": "STORAGE_ANALYTICS_B",
      "database_name": "synthetic-storage-analytics-b",
      "database_id": "00000000-0000-0000-0000-000000000007"
    },
    {
      "binding": "STORAGE_PUBLICATION_DB",
      "database_name": "synthetic-storage-publication-db",
      "database_id": "00000000-0000-0000-0000-000000000008"
    },
    {
      "binding": "STORAGE_ANALYTICS_C",
      "database_name": "synthetic-storage-analytics-c",
      "database_id": "00000000-0000-0000-0000-000000000009"
    }
  ]
}
