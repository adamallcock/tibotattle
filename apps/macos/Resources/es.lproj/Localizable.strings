"dialog.identityDeviceReset" = "Restablecer identidad y dispositivo…";
"dialog.identityDeviceResetComplete" = "Identidad local y dispositivo restablecidos";
"dialog.identityDeviceResetCompleteDescription" = "Estado de la app: se conserva, salvo el marcador de vinculación local del dispositivo afectado y el residuo de identidad retirado.\n\nLlavero: la identidad de exportación de %@ y la credencial de dispositivo emparejado ya no están. No se afirma un borrado seguro.\n\nServicio alojado: no se revocó ningún dispositivo ni se eliminó ningún dato. Vuelve a emparejar esta app antes de una futura contribución y usa por separado el flujo de privacidad alojado para la eliminación alojada.";
"dialog.identityDeviceResetDescription" = "Esta es una acción local específica de recuperación de seguridad, no una desinstalación ni una eliminación alojada.\n\nEstado de la app: los índices, el análisis en caché, las contribuciones preparadas, la configuración y los registros de Codex permanecen. Solo se eliminan el marcador de vinculación local del dispositivo y cualquier residuo de identidad de archivo retirado.\n\nLlavero: se eliminan la identidad de exportación de %@ y la credencial de dispositivo emparejado. Las claves de seudónimo de observación de cuenta y de sesión de Claude no se modifican.\n\nServicio alojado: no se revoca ningún dispositivo registrado ni se elimina ninguna contribución o resultado alojado. Usa por separado el flujo de privacidad alojado. No se afirma un borrado seguro.";
"dialog.localAppData" = "Datos locales de la app";
"dialog.localAppDataDescription" = "Esta carpeta de Application Support, disponible solo para el propietario, contiene configuración, índices, análisis en caché, contribuciones preparadas y estado de vinculación local del dispositivo. Es independiente de los registros de Codex, el Llavero y los datos alojados.";
"dialog.manageData" = "Gestionar datos…";
"dialog.manageLocalData" = "Gestionar datos locales de %@";
"dialog.manageLocalDataDescription" = "El estado local de la app, las capacidades locales del Llavero y los datos alojados son independientes. Elige la capa exacta que quieres gestionar.";
"dialog.moveDataToTrash" = "Mover datos a la Papelera";
"dialog.moveLocalDataToTrash" = "¿Mover todos los datos locales de %@ a la Papelera?";
"dialog.moveLocalDataToTrashDescription" = "Estado de la app: se borran los índices locales, el análisis en caché, las contribuciones preparadas, la configuración personalizada de Codex, la vinculación local del dispositivo y el estado de inicio de sesión y sesión de TiboTattle. Los archivos se mueven a la Papelera.\n\nLlavero: la identidad seudónima y las credenciales del dispositivo permanecen.\n\nServicio alojado: los datos comunitarios enviados y los dispositivos registrados permanecen. Los registros de Codex nunca se modifican.";
"dialog.resetCapabilities" = "¿Restablecer ahora exactamente dos capacidades locales del Llavero?";
"dialog.resetCapabilitiesDescription" = "%@ detendrá su acompañante en primer plano, eliminará del Llavero su identidad de exportación y credencial de dispositivo emparejado, eliminará solo sus dos archivos de residuo locales y luego se reiniciará.\n\nLos datos preparados o alojados existentes no se reescribirán ni eliminarán. La actividad de contribución futura usará una identidad nueva y requerirá emparejar el dispositivo de nuevo.";
"dialog.resetFinishing" = "El restablecimiento de identidad local está terminando";
