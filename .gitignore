# Derived reports/artifacts and QA captures embed local aggregate observations.
artifact.json
*-artifact.json
*-report.html
*-verification-failure.png
*.html.tmp-*
verify-debug.png

# Interrupted atomic staging for root-local report/artifact outputs only.
/artifact.json.*.tmp
/*-artifact.json.*.tmp
/.artifact.json.*.tmp
/.*-artifact.json.*.tmp
/*-report.html.*.tmp
/.*-report.html.*.tmp

# Swift Package Manager build and test output for the macOS app.
apps/macos/.build/

# Package manager store
.pnpm-store/
