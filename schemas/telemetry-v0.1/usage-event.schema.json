{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://app-usagemonitor.local/schemas/telemetry-v0.1/usage-event.schema.json",
  "title": "Privacy-safe usage event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventTime",
    "provider",
    "modelId",
    "modelRecognition",
    "modelFingerprint",
    "billingSurface",
    "speedMode",
    "apiServiceTier",
    "reasoningEffort",
    "components",
    "totalInputContextTokens",
    "surface",
    "agentScope",
    "lineageDisposition",
    "toolClassCounts",
    "outcome",
    "eventId",
    "sessionScopeId",
    "accountScopeId"
  ],
  "properties": {
    "schemaVersion": { "const": "usage-event-v0.1" },
    "eventTime": { "type": "string", "format": "date-time", "maxLength": 32 },
    "provider": { "enum": ["openai_codex", "anthropic_claude_code"] },
    "modelId": {
      "enum": ["unknown","codex-auto-review","gpt-4-turbo-2024-04-09","gpt-4.1","gpt-4.1-mini","gpt-4.1-nano","gpt-4o","gpt-4o-2024-05-13","gpt-4o-mini","gpt-5","gpt-5-codex","gpt-5-mini","gpt-5-nano","gpt-5-pro","gpt-5.1","gpt-5.1-codex","gpt-5.1-codex-mini","gpt-5.2","gpt-5.2-codex","gpt-5.2-pro","gpt-5.3-codex","gpt-5.3-codex-spark","gpt-5.4","gpt-5.4-mini","gpt-5.4-nano","gpt-5.4-pro","gpt-5.5","gpt-5.5-codex","gpt-5.5-pro","gpt-5.6-luna","gpt-5.6-sol","gpt-5.6-sol-wm","gpt-5.6-terra","gpt-6-astra","o1","o1-pro","o3","o3-mini","o3-pro","o4-mini","claude-fable-5","claude-haiku-4-5-20251001","claude-opus-4-8","claude-sonnet-4-6","claude-sonnet-5"]
    },
    "modelRecognition": { "enum": ["recognized", "unrecognized", "missing"] },
    "modelFingerprint": {
      "type": ["string", "null"],
      "pattern": "^model:v1:[a-f0-9]{64}$"
    },
    "billingSurface": { "enum": ["chatgpt_subscription", "openai_api", "claude_subscription", "unknown"] },
    "speedMode": { "enum": ["standard", "fast", "unknown", "other"] },
    "apiServiceTier": { "enum": ["standard", "priority", "flex", "batch", "unknown", "other"] },
    "reasoningEffort": { "enum": ["none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra", "unknown"] },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputUncachedTokens",
        "inputCacheReadTokens",
        "inputCacheWriteTokens",
        "inputCacheWrite5mTokens",
        "inputCacheWrite1hTokens",
        "outputTextTokens",
        "outputReasoningTokens",
        "outputCombinedTokens"
      ],
      "properties": {
        "inputUncachedTokens": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991 },
        "inputCacheReadTokens": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991 },
        "inputCacheWriteTokens": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991 },
        "inputCacheWrite5mTokens": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991 },
        "inputCacheWrite1hTokens": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991 },
        "outputTextTokens": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991 },
        "outputReasoningTokens": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991 },
        "outputCombinedTokens": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991 }
      }
    },
    "totalInputContextTokens": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991 },
    "surface": {
      "enum": [
        "scheduled_task",
        "subagent",
        "extension_or_ide",
        "cli_exec",
        "local_interactive_unclassified",
        "local_rollout_unclassified"
      ]
    },
    "agentScope": { "enum": ["root", "subagent", "automation", "unknown"] },
    "lineageDisposition": { "enum": ["standalone", "forked", "parent_linked"] },
    "toolClassCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "webSearch", "fileSearch", "codeInterpreter", "hostedShell", "computerUse", "mcp",
        "applyPatch", "localShell", "subagent", "toolGateway", "other", "unknown"
      ],
      "properties": {
        "webSearch": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "fileSearch": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "codeInterpreter": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "hostedShell": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "computerUse": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "mcp": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "applyPatch": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "localShell": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "subagent": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "toolGateway": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "other": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "unknown": { "type": "integer", "minimum": 0, "maximum": 1000000 }
      }
    },
    "outcome": { "enum": ["completed", "failed", "cancelled", "interrupted", "retry", "unknown"] },
    "eventId": { "type": "string", "pattern": "^event:v2:[a-f0-9]{64}$" },
    "sessionScopeId": { "type": "string", "pattern": "^session:v1:[a-f0-9]{64}$" },
    "accountScopeId": {
      "type": "string",
      "pattern": "^(unattributed|account:v1:[a-f0-9]{64})$"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "modelRecognition": { "const": "recognized" } } },
      "then": {
        "properties": {
          "modelId": { "enum": ["codex-auto-review","gpt-4-turbo-2024-04-09","gpt-4.1","gpt-4.1-mini","gpt-4.1-nano","gpt-4o","gpt-4o-2024-05-13","gpt-4o-mini","gpt-5","gpt-5-codex","gpt-5-mini","gpt-5-nano","gpt-5-pro","gpt-5.1","gpt-5.1-codex","gpt-5.1-codex-mini","gpt-5.2","gpt-5.2-codex","gpt-5.2-pro","gpt-5.3-codex","gpt-5.3-codex-spark","gpt-5.4","gpt-5.4-mini","gpt-5.4-nano","gpt-5.4-pro","gpt-5.5","gpt-5.5-codex","gpt-5.5-pro","gpt-5.6-luna","gpt-5.6-sol","gpt-5.6-sol-wm","gpt-5.6-terra","gpt-6-astra","o1","o1-pro","o3","o3-mini","o3-pro","o4-mini","claude-fable-5","claude-haiku-4-5-20251001","claude-opus-4-8","claude-sonnet-4-6","claude-sonnet-5"] },
          "modelFingerprint": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "modelRecognition": { "const": "unrecognized" } } },
      "then": {
        "properties": {
          "modelId": { "const": "unknown" },
          "modelFingerprint": { "type": "string", "pattern": "^model:v1:[a-f0-9]{64}$" }
        }
      }
    },
    {
      "if": { "properties": { "modelRecognition": { "const": "missing" } } },
      "then": {
        "properties": {
          "modelId": { "const": "unknown" },
          "modelFingerprint": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "provider": { "const": "anthropic_claude_code" } } },
      "then": {
        "properties": {
          "billingSurface": { "const": "claude_subscription" },
          "apiServiceTier": { "const": "unknown" },
          "reasoningEffort": { "const": "unknown" },
          "modelId": {
            "enum": [
              "unknown", "claude-fable-5", "claude-haiku-4-5-20251001",
              "claude-opus-4-8", "claude-sonnet-4-6", "claude-sonnet-5"
            ]
          },
          "components": {
            "type": "object",
            "properties": {
              "inputUncachedTokens": { "type": "integer" },
              "inputCacheReadTokens": { "type": "integer" },
              "inputCacheWriteTokens": { "type": "integer" },
              "inputCacheWrite5mTokens": { "type": ["integer", "null"] },
              "inputCacheWrite1hTokens": { "type": ["integer", "null"] },
              "outputTextTokens": { "type": "null" },
              "outputReasoningTokens": { "type": "null" },
              "outputCombinedTokens": { "type": "integer" }
            },
            "oneOf": [
              {
                "properties": {
                  "inputCacheWrite5mTokens": { "type": "null" },
                  "inputCacheWrite1hTokens": { "type": "null" }
                }
              },
              {
                "properties": {
                  "inputCacheWrite5mTokens": { "type": "integer" },
                  "inputCacheWrite1hTokens": { "type": "integer" }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": { "properties": { "provider": { "const": "openai_codex" } } },
      "then": {
        "properties": {
          "modelId": {
            "enum": ["unknown","codex-auto-review","gpt-4-turbo-2024-04-09","gpt-4.1","gpt-4.1-mini","gpt-4.1-nano","gpt-4o","gpt-4o-2024-05-13","gpt-4o-mini","gpt-5","gpt-5-codex","gpt-5-mini","gpt-5-nano","gpt-5-pro","gpt-5.1","gpt-5.1-codex","gpt-5.1-codex-mini","gpt-5.2","gpt-5.2-codex","gpt-5.2-pro","gpt-5.3-codex","gpt-5.3-codex-spark","gpt-5.4","gpt-5.4-mini","gpt-5.4-nano","gpt-5.4-pro","gpt-5.5","gpt-5.5-codex","gpt-5.5-pro","gpt-5.6-luna","gpt-5.6-sol","gpt-5.6-sol-wm","gpt-5.6-terra","gpt-6-astra","o1","o1-pro","o3","o3-mini","o3-pro","o4-mini"]
          },
          "components": {
            "type": "object",
            "properties": {
              "outputCombinedTokens": { "type": "null" },
              "inputCacheWrite5mTokens": { "type": "null" },
              "inputCacheWrite1hTokens": { "type": "null" }
            }
          }
        }
      }
    }
  ]
}
