{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://app-usagemonitor.local/schemas/telemetry-v0.1/quota-snapshot.schema.json",
  "title": "Privacy-safe quota snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "observedTime",
    "receivedTime",
    "provider",
    "planType",
    "planVariant",
    "limitId",
    "slot",
    "usedPercent",
    "displayPrecision",
    "windowDurationMinutes",
    "resetsAt",
    "snapshotSource",
    "providerSurface",
    "snapshotId",
    "providerStateId",
    "sessionScopeId",
    "accountScopeId"
  ],
  "properties": {
    "schemaVersion": { "const": "quota-snapshot-v0.1" },
    "observedTime": { "type": "string", "format": "date-time", "maxLength": 32 },
    "receivedTime": { "type": "string", "format": "date-time", "maxLength": 32 },
    "provider": { "enum": ["openai_codex", "anthropic_claude_code"] },
    "planType": { "enum": ["free", "go", "plus", "pro", "business", "enterprise", "edu", "team", "unknown"] },
    "planVariant": { "enum": ["pro-20x", "pro-10x-promo", "pro-5x", "plus", "unknown"] },
    "limitId": { "enum": ["unknown", "codex", "codex-spark"] },
    "slot": { "enum": ["primary", "secondary", "five_hour", "seven_day", "other", "unknown"] },
    "usedPercent": { "type": "number", "minimum": 0, "maximum": 100 },
    "displayPrecision": { "type": "integer", "minimum": 0, "maximum": 6 },
    "windowDurationMinutes": { "type": "integer", "minimum": 1, "maximum": 525600 },
    "resetsAt": { "type": "string", "format": "date-time", "maxLength": 32 },
    "snapshotSource": { "enum": ["rollout", "app_server_read", "status_line", "ui_declaration", "notification"] },
    "providerSurface": { "enum": ["account_shared_unallocated", "general_usage", "model_specific", "separate_limit", "unknown"] },
    "snapshotId": { "type": "string", "pattern": "^snapshot:v2:[A-Za-z0-9_-]{43}$" },
    "providerStateId": { "type": "string", "pattern": "^quota-state:v1:[A-Za-z0-9_-]{43}$" },
    "sessionScopeId": {
      "type": ["string", "null"],
      "pattern": "^session:v1:[A-Za-z0-9_-]{43}$"
    },
    "accountScopeId": {
      "type": "string",
      "pattern": "^(unattributed|account:v1:[A-Za-z0-9_-]{43})$"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "provider": { "const": "anthropic_claude_code" } } },
      "then": {
        "properties": {
          "limitId": { "const": "unknown" },
          "snapshotSource": { "const": "status_line" },
          "providerSurface": { "const": "general_usage" },
          "sessionScopeId": { "type": "string" }
        }
      }
    },
    {
      "if": { "properties": { "snapshotSource": { "const": "status_line" } } },
      "then": {
        "properties": {
          "provider": { "const": "anthropic_claude_code" },
          "sessionScopeId": { "type": "string" }
        }
      }
    },
    {
      "if": { "properties": { "snapshotSource": { "const": "rollout" } } },
      "then": {
        "properties": {
          "provider": { "const": "openai_codex" },
          "sessionScopeId": { "type": "string" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "snapshotSource": { "enum": ["app_server_read", "notification"] }
        }
      },
      "then": {
        "properties": {
          "provider": { "const": "openai_codex" },
          "providerSurface": { "const": "account_shared_unallocated" },
          "sessionScopeId": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "sessionScopeId": { "type": "null" } } },
      "then": {
        "properties": {
          "provider": { "const": "openai_codex" },
          "snapshotSource": { "enum": ["app_server_read", "notification"] },
          "providerSurface": { "const": "account_shared_unallocated" }
        }
      }
    }
  ]
}
