{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://app-usagemonitor.local/schemas/telemetry-v0.1/compatibility.schema.json",
  "title": "Local usage export compatibility tuple",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tupleVersion", "schemas", "fieldContract", "implementation", "providerAdapters",
    "registry", "consent", "contract"
  ],
  "properties": {
    "tupleVersion": { "const": "usage-export-compatibility-v0.1" },
    "schemas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["setSha256", "members"],
      "properties": {
        "setSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "members": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "id", "sha256"],
            "properties": {
              "name": { "enum": ["activity-marker.schema.json", "bundle.schema.json", "compatibility.schema.json", "privacy-receipt.schema.json", "quota-snapshot.schema.json", "usage-event.schema.json"] },
              "id": { "type": "string", "pattern": "^https://app-usagemonitor\\.local/schemas/telemetry-v0\\.1/[a-z-]+\\.schema\\.json$", "maxLength": 128 },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          }
        }
      }
    },
    "fieldContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sha256"],
      "properties": {
        "version": { "const": "telemetry-field-dictionary-v0.1" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exporterVersion", "resourcePolicyVersion", "checkpointParserVersion", "checkpointScanVersion", "packageName", "packageVersion"],
      "properties": {
        "exporterVersion": { "const": "0.3.0-draft.3" },
        "resourcePolicyVersion": { "const": "g1-r3-candidate-0.4" },
        "checkpointParserVersion": { "const": "codex-checkpoint-state-v0.1" },
        "checkpointScanVersion": { "const": "codex-export-checkpoint-scan-v0.2" },
        "packageName": { "const": "app-usagemonitor" },
        "packageVersion": { "const": "0.0.1" }
      }
    },
    "providerAdapters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["openaiCodex", "anthropicClaudeCode"],
      "properties": {
        "openaiCodex": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "sourceFormat", "parserVersion", "adapterVersion"],
          "properties": {
            "status": { "const": "implemented" },
            "sourceFormat": { "const": "codex-rollout-jsonl" },
            "parserVersion": { "const": "codex-log-scan-v5" },
            "adapterVersion": { "const": "codex-metadata-export-v5" }
          }
        },
        "anthropicClaudeCode": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "sourceFormat", "parserVersion", "adapterVersion"],
          "properties": {
            "status": { "const": "not_implemented" },
            "sourceFormat": { "type": "null" },
            "parserVersion": { "type": "null" },
            "adapterVersion": { "type": "null" }
          }
        }
      }
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sha256"],
      "properties": {
        "version": { "const": "telemetry-v0.1-registry-2026-07-24.1" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "status", "statusSha256"],
      "properties": {
        "version": { "const": "local-dry-run-v0.1" },
        "status": { "const": "local_review_only_no_transport" },
        "statusSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "status", "transportReady", "externalParticipantsAuthorized", "backwardCompatibility", "statusSha256"],
      "properties": {
        "family": { "const": "telemetry-v0.1" },
        "status": { "const": "draft_local_only_unfrozen" },
        "transportReady": { "const": false },
        "externalParticipantsAuthorized": { "const": false },
        "backwardCompatibility": { "const": "none_regenerate_local_review_artifacts" },
        "statusSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
