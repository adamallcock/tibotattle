{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://app-usagemonitor.local/schemas/telemetry-v0.1/privacy-receipt.schema.json",
  "title": "Local privacy verification receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "compatibility",
    "createdAt",
    "bundleId",
    "participantId",
    "bundleSha256",
    "bundleBytes",
    "verdict",
    "transportReady",
    "coveredAt",
    "recordCounts",
    "checks",
    "excludedCategories"
  ],
  "properties": {
    "schemaVersion": { "const": "privacy-receipt-v0.1" },
    "compatibility": { "$ref": "https://app-usagemonitor.local/schemas/telemetry-v0.1/compatibility.schema.json" },
    "createdAt": { "type": "string", "format": "date-time", "maxLength": 32 },
    "bundleId": { "type": "string", "pattern": "^bundle:v1:[A-Za-z0-9_-]{43}$" },
    "participantId": { "type": "string", "pattern": "^participant:v1:[A-Za-z0-9_-]{43}$" },
    "bundleSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "bundleBytes": { "type": "integer", "minimum": 1, "maximum": 33554432 },
    "verdict": { "enum": ["passed", "failed"] },
    "transportReady": { "const": false },
    "coveredAt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startAt", "endAt"],
      "properties": {
        "startAt": { "type": "string", "format": "date-time", "maxLength": 32 },
        "endAt": { "type": "string", "format": "date-time", "maxLength": 32 }
      }
    },
    "recordCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["usageEvents", "quotaSnapshots", "activityMarkers"],
      "properties": {
        "usageEvents": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "quotaSnapshots": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "activityMarkers": { "type": "integer", "minimum": 0, "maximum": 100000 }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 4,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "status", "violations"],
        "properties": {
          "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
          "status": { "enum": ["passed", "failed"] },
          "violations": { "type": "integer", "minimum": 0, "maximum": 1000000 }
        }
      }
    },
    "excludedCategories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "enum": [
          "prompt_and_response_content",
          "credentials_and_authentication_material",
          "raw_account_session_and_device_identifiers",
          "repository_paths_filenames_branches_and_project_names",
          "tool_names_arguments_commands_and_urls",
          "hostnames_usernames_ip_addresses_and_locale",
          "free_form_labels_and_unknown_fields"
        ]
      }
    }
  }
}
