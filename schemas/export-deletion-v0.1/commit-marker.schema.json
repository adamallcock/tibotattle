{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://app-usagemonitor.local/schemas/export-deletion-v0.1/commit-marker.schema.json",
  "title": "Usage monitor local export deletion commit marker v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "planVersion", "deletionOrderVersion", "state", "directoryIdentities", "planSha256", "journalSha256", "transportReady"],
  "properties": {
    "schemaVersion": { "const": "usage-export-deletion-commit-marker-v0.1" },
    "planVersion": { "const": "local-export-deletion-plan-v0.1" },
    "deletionOrderVersion": { "const": "manifest-bundles-workspace-receipts-v1" },
    "state": { "const": "committed" },
    "directoryIdentities": { "$ref": "#/definitions/directoryIdentities" },
    "planSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "journalSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "transportReady": { "const": false }
  },
  "definitions": {
    "directoryIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device", "inode"],
      "properties": {
        "device": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "inode": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      }
    },
    "directoryIdentities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace", "output"],
      "properties": {
        "workspace": { "$ref": "#/definitions/directoryIdentity" },
        "output": { "$ref": "#/definitions/directoryIdentity" }
      }
    }
  }
}
