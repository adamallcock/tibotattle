{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://app-usagemonitor.local/schemas/export-workspace-discard-v0.1/receipt.schema.json",
  "title": "Usage monitor local export workspace discard receipt v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "planVersion", "artifactClass", "state", "logicalRemovalConfirmed", "deletedFileCount", "deletedBytes", "sourceLogsPreserved", "identityStatePreserved", "independentOutputPreserved", "workspaceDirectoryRetained", "networkActivity", "secureErasureClaimed", "transportReady"],
  "properties": {
    "schemaVersion": { "const": "usage-export-workspace-discard-receipt-v0.1" },
    "planVersion": { "const": "local-export-workspace-discard-plan-v0.1" },
    "artifactClass": { "const": "incomplete_or_poisoned_export_workspace" },
    "state": { "const": "complete" },
    "logicalRemovalConfirmed": { "const": true },
    "deletedFileCount": { "type": "integer", "minimum": 1, "maximum": 4 },
    "deletedBytes": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "sourceLogsPreserved": { "const": true },
    "identityStatePreserved": { "const": true },
    "independentOutputPreserved": { "const": true },
    "workspaceDirectoryRetained": { "const": true },
    "networkActivity": { "const": "absent" },
    "secureErasureClaimed": { "const": false },
    "transportReady": { "const": false }
  }
}
