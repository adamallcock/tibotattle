{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://app-usagemonitor.local/schemas/export-workspace-discard-v0.1/journal.schema.json",
  "title": "Usage monitor durable export workspace discard journal v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "planVersion", "discardOrderVersion", "artifactClass", "state", "planToken", "directoryIdentityToken", "eligibility", "inventoryCounts", "inventory", "transportReady"],
  "properties": {
    "schemaVersion": { "const": "usage-export-workspace-discard-journal-v0.1" },
    "planVersion": { "const": "local-export-workspace-discard-plan-v0.1" },
    "discardOrderVersion": { "const": "sqlite-sidecars-then-database-v1" },
    "artifactClass": { "const": "incomplete_or_poisoned_export_workspace" },
    "state": { "const": "prepared" },
    "planToken": { "type": "string", "pattern": "^[A-Z2-7]{20}$" },
    "directoryIdentityToken": { "type": "string", "pattern": "^[A-Z2-7]{52}$" },
    "eligibility": { "enum": ["poisoned", "scan_incomplete"] },
    "inventoryCounts": {
      "type": "object", "additionalProperties": false,
      "required": ["sqliteSidecars", "workspaceDatabase", "totalFiles", "totalBytes"],
      "properties": {
        "sqliteSidecars": { "type": "integer", "minimum": 0, "maximum": 3 },
        "workspaceDatabase": { "const": 1 },
        "totalFiles": { "type": "integer", "minimum": 1, "maximum": 4 },
        "totalBytes": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      }
    },
    "inventory": {
      "type": "array", "minItems": 1, "maxItems": 4,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["ordinal", "role", "byteSize", "evidenceToken"],
        "properties": {
          "ordinal": { "type": "integer", "minimum": 0, "maximum": 3 },
          "role": { "enum": ["workspace_sqlite_journal", "workspace_sqlite_wal", "workspace_sqlite_shm", "workspace_database"] },
          "byteSize": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
          "evidenceToken": { "type": "string", "pattern": "^[A-Z2-7]{52}$" }
        }
      }
    },
    "transportReady": { "const": false }
  }
}
